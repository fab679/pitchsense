# ==============================================================================
# PitchSense Environment Configuration (100% Microsoft Azure Native)
# ==============================================================================

# 1. Microsoft AI Foundry / Azure OpenAI
# Required for live cloud model calls with gpt-4.1-mini:
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT="https://foundry-pitchsense.openai.azure.com/openai/v1"

# 2. Execution Mode Selector
# Set to "0" to enable LIVE LLM agent calls via Microsoft Foundry
# Set to "1" to run 100% OFFLINE in deterministic mode (zero keys required)
PSENSE_FAKE_MODEL="0"
